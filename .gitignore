__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
.DS_Store

# MkDocs output. The docs site is built and deployed by CI, never committed.
/site/

# Raw upstream responses stay local. A fresh clone downloads missing inputs
# on its first build or check. Cache classification records the source policy;
# it does not enforce restrictions on generated output. See docs/sources.md.
cache/open/*
cache/restricted/*
!cache/open/.gitkeep
!cache/README.md

# The same rule, one step downstream. btc-in-gold derives from a source that
# states no open licence, so its computed files are rebuilt by a clone rather
# than shipped in one. dist/index.json still lists it; run `trends build`.
dist/series/btc-in-gold.json
dist/series/btc-in-gold.csv

# `dist/` here holds published JSON, not Python build output — but that is where
# `uv build` and `hatch build` put a wheel by default. Ignore those so a stray
# packaging run cannot get committed alongside the series.
dist/*.whl
dist/*.tar.gz
